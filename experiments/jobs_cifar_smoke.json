{
  "batch": "cifar_smoke",
  "output_dir": "results/cifar_smoke",
  "common": ["--task", "cifar_resnet9", "--partition", "dirichlet", "--dirichlet_alpha", "0.2",
             "--num_clients", "100", "--clients_per_round", "5",
             "--total_rounds", "20", "--seed", "42", "--local_epochs", "3",
             "--server_lr", "1.0", "--weight_decay", "5e-4",
             "--scale_mode", "doscale"],
  "jobs": [
    {"name": "cifar_unc_lrA", "args": ["--transform", "uncompressed", "--bits", "8", "--stochastic", "1", "--client_lr", "0.05", "--client_momentum", "0.0", "--exp_name", "cifar_unc_lrA"], "threads": 4},
    {"name": "cifar_unc_lrB", "args": ["--transform", "uncompressed", "--bits", "8", "--stochastic", "1", "--client_lr", "0.02", "--client_momentum", "0.9", "--exp_name", "cifar_unc_lrB"], "threads": 4},
    {"name": "cifar_kb2_lrA", "args": ["--transform", "fourier_kashin_balanced", "--bits", "2", "--lam", "1.3", "--stochastic", "1", "--kashin_iters", "15", "--kashin_eta", "0.9", "--client_lr", "0.05", "--client_momentum", "0.0", "--exp_name", "cifar_kb2_lrA"], "threads": 4},
    {"name": "cifar_kb2_lrB", "args": ["--transform", "fourier_kashin_balanced", "--bits", "2", "--lam", "1.3", "--stochastic", "1", "--kashin_iters", "15", "--kashin_eta", "0.9", "--client_lr", "0.02", "--client_momentum", "0.9", "--exp_name", "cifar_kb2_lrB"], "threads": 4}
  ]
}
